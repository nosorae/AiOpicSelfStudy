# 스토어 등록 문구, 심사 메모, 스크린샷, iOS 빌드를 올린다. 심사 제출은 하지 않는다.
# 계정 키는 저장소 밖 파일 경로를 환경 변수로 받는다. 사용법은 docs/release.md.

skip_docs # 실행할 때마다 fastlane/README.md 를 새로 쓰지 않게 한다

APP_ID = "io.github.nosorae.aiopic"
# 절대 경로로 둔다. fastlane 은 lane 본문을 fastlane/ 에서, 액션을 그 위 폴더에서 돌려서
# 상대 경로를 넘기면 deliver 가 없는 폴더를 읽고 스크린샷 0장을 성공으로 끝낸다.
DIR = File.expand_path(FastlaneCore::FastlaneFolder.path)

# 스크린샷이 없으면 문구만 올리고 콘솔의 기존 이미지는 그대로 둔다. 스크린샷 찍는 법은 docs/release.md 의 "스토어 문구 올리기".
def images?(dir)
  Dir.glob(File.join(dir, "**", "*.{png,jpg,jpeg}")).any?
end

desc "Play 와 App Store 에 문구와 스크린샷을 올린다"
lane :store do
  play
  app_store
end

desc "Play 스토어 등록정보를 올린다. PLAY_JSON_KEY_PATH: 서비스 계정 JSON 경로"
lane :play do
  metadata = File.join(DIR, "metadata/android")
  supply(
    package_name: APP_ID,
    json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
    metadata_path: metadata,
    skip_upload_apk: true,
    skip_upload_aab: true,
    skip_upload_changelogs: true,
    skip_upload_images: !images?(metadata),
    skip_upload_screenshots: !images?(metadata)
  )
end

desc "App Store 등록정보와 심사 메모를 올린다. ASC_API_KEY_PATH: API 키 JSON 경로, REVIEW_GEMINI_KEY: 심사용 키"
lane :app_store do
  metadata = File.join(DIR, "metadata/ios")
  screenshots = File.join(DIR, "screenshots/ios")
  notes = File.read(File.join(metadata, "review_information/notes.txt"))
  deliver(
    app_identifier: APP_ID,
    api_key_path: ENV.fetch("ASC_API_KEY_PATH"),
    metadata_path: metadata,
    screenshots_path: screenshots,
    skip_binary_upload: true,
    skip_screenshots: !images?(screenshots),
    overwrite_screenshots: true,
    submit_for_review: false,
    run_precheck_before_submit: false,
    force: true,
    app_review_information: { notes: notes.sub("{{REVIEW_GEMINI_KEY}}", ENV.fetch("REVIEW_GEMINI_KEY")) }
  )
end

desc "App Store 용 ipa 를 TestFlight 에 올린다. 빌드 번호는 Config.xcconfig 의 CURRENT_PROJECT_VERSION. ASC_API_KEY_PATH: API 키 JSON 경로"
# ipa 이름은 xcodebuild -exportArchive 가 앱 번들 이름(Config.xcconfig 의 PRODUCT_NAME)에서 따온다
lane :ios_build do
  upload_to_testflight(
    api_key_path: ENV.fetch("ASC_API_KEY_PATH"),
    ipa: File.expand_path("../build/release/ipa/AiOpicSelfStudy.ipa", DIR),
    skip_waiting_for_build_processing: true
  )
end
