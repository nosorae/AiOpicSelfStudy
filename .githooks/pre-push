#!/bin/sh
# 푸시하는 커밋이 이슈나 작업 노드와 이어져 있는지, 민감 정보가 없는지 확인한다.
# 설치: scripts/setup-hooks.sh
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0

while read -r _ local_sha _ _; do
    [ "$local_sha" = "$zero" ] && continue # 브랜치 삭제
    range="origin/main..$local_sha"

    for commit in $(git rev-list "$range"); do
        message=$(git log -1 --format=%B "$commit")
        case "$message" in Merge* | Initial*) continue ;; esac
        if ! printf '%s' "$message" | grep -qE '\[[A-Za-z0-9._-]+\]|#[0-9]+'; then
            echo "[커밋 메시지] $(git log -1 --format='%h %s' "$commit")" >&2
            echo "  메시지에 작업 노드 [노드id] 나 이슈 번호 #숫자 가 없다." >&2
            status=1
        fi
    done
    if [ $status -ne 0 ]; then
        echo "고칠 방법: git rebase -i origin/main 에서 그 커밋을 reword 로 바꿔 '[h3] 무엇을 했다 (#4)' 형식으로 고친다." >&2
    fi

    python3 "$root/scripts/check-secrets.py" "$range" || status=1
done

exit $status
